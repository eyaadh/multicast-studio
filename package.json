{
  "name": "multicast-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "npm run typecheck && vite build --config web/vite.config.ts && tsc -p server/tsconfig.json",
    "typecheck": "vue-tsc --noEmit -p web/tsconfig.json && tsc --noEmit -p server/tsconfig.json",
    "start": "node server/dist/index.js",
    "test": "node --import tsx --test server/test/*.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "@headlessui/vue": "^1.7.23",
    "hls.js": "^1.5.20",
    "better-sqlite3": "^12.0.0",
    "dotenv": "^16.6.0",
    "hono": "^4.9.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "concurrently": "^9.2.0",
    "lucide-vue-next": "^0.468.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vue": "^3.5.0",
    "vue-tsc": "^3.0.0"
  },
  "engines": {"node": ">=22.12"}
}
