# Copy to .env and change BOTH secrets. Do not commit .env.
ADMIN_USER=admin
ADMIN_PASSWORD=SET_A_LONG_UNIQUE_PASSWORD_HERE
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
# Set true only if you terminate HTTPS at a trusted reverse proxy.
COOKIE_SECURE=false
